rule Scheme_wf/scheme: ;; TODO
  typeEnv |- FORALL tids `. conss `-> typeScheme
  -- if false

rule Scheme_wf/just:
  typeEnv |- JUST type
  -- Type_wf: typeEnv |- type

rule Scheme_wf/empty_just:
  typeEnv |- FORALL eps `. eps `-> typeScheme
  -- Scheme_wf: typeEnv |- typeScheme

rule Type_wf/unit:
  typeEnv |- UNITT

rule Type_wf/tid: ;; TODO
  typeEnv |- tid
  -- if false

rule Type_wf/fun:
  typeEnv |- FUNCT t* type
  -- (Type_wf: typeEnv |- t)*
  -- Type_wf: typeEnv |- type

rule Type_wf/ref:
  typeEnv |- REFT type
  -- Type_wf: typeEnv |- type

rule Type_wf/struct: ;; TODO
  typeEnv |- STRUCTT id type*
  -- if false