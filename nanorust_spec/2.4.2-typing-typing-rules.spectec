;; Since we need mutual context on every items,
;; We first collect all context w/o type checking.
;; Then, we type check with that context.
rule Program_ok/pgm:
  |- pgm : typeEnv ~~ consEnv
  -- if item* = pgm
  -- Construct_pgm_context: item* ~> typeEnv ~~ consEnv
  -- (Item_ok: typeEnv ~~ consEnv |- item)*

var newTypeEnv: typeEnv
var newConsEnv: consEnv
var returnType: type

;; Typing rule for items (TODO)
rule Item_ok/struct:
  typeEnv ~~ consEnv |- STRUCT id tid* `{ varType* }
  -- if newTypeEnv = typeEnv ++ (TVAR tid)*
  -- if (type = $getParamType(varType))*
  -- (Scheme_wf: newTypeEnv |- (JUST type))*

rule Item_ok/func:
  typeEnv ~~ consEnv |- FN id tid* varType* `-> type WHERE cons* `{ term }
  -- if ($getParamType(varType) = t)*
  -- if funType = FUNCT t* type
  -- if scheme = FORALL tid* `. cons* `-> ( JUST funType )
  -- Scheme_wf: typeEnv |- scheme
  -- if newTypeEnv = typeEnv ++ (TVAR tid)* ++ ($varTypeToTypeEnv(varType))*
  -- if newConsEnv = consEnv ++ (JUST cons)*
  -- Term_ok: newTypeEnv ~~ newConsEnv |- term : returnType
  -- if type = returnType

rule Item_ok/trait: ;; TODO
  typeEnv ~~ consEnv |- TRAIT id tids WHERE conss `{ fid `: typeScheme }
  -- if false

rule Item_ok/impl: ;; TODO
  typeEnv ~~ consEnv |- IMPL tids id types FOR type WHERE conss `{ func }
  -- if false